{
  "rules": {
    "usuarios": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid",
        "gastos": {
          "$id": {
            ".validate": "newData.hasChildren(['id', 'type', 'amount', 'date']) && newData.child('id').val() === $id",
            "type": { ".validate": "newData.val() === 'Egreso' || newData.val() === 'Ingreso'" },
            "amount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "date": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" }
          }
        },
        "usd": {
          "$id": {
            ".validate": "newData.hasChildren(['id', 'type', 'usdAmount']) && newData.child('id').val() === $id",
            "type": { ".validate": "newData.val() === 'ingreso' || newData.val() === 'compra' || newData.val() === 'venta'" },
            "usdAmount": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        },
        "debts": {
          "$id": {
            ".validate": "newData.hasChildren(['id', 'amount']) && newData.child('id').val() === $id",
            "amount": { ".validate": "newData.isNumber()" }
          }
        },
        "settings": {
          ".validate": "newData.hasChildren(['updatedAt'])",
          "updatedAt": { ".validate": "newData.isNumber()" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
